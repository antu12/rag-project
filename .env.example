# Copy to .env for local shell usage if desired. Do not commit real secrets.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Optional non-secret overrides.
RAG_PROVIDER=openai
RAG_STORE=pgvector
RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_OPENAI_GENERATION_MODEL=gpt-4o-mini
RAG_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
RAG_GEMINI_GENERATION_MODEL=gemini-3.5-flash
RAG_GEMINI_EMBEDDING_RETRIES=20
RAG_GEMINI_EMBEDDING_DELAY_SECONDS=0.7
RAG_POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag
RAG_QDRANT_URL=http://localhost:6333

# Optional local Inngest development settings.
# These are not OpenAI/Gemini API keys. They are used by the local Inngest Dev Server handshake.
INNGEST_DEV=1
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=signkey-test-00000000000000000000000000000000
